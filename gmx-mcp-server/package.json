{
  "name": "gmx-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for GMX email (IMAP read + SMTP send) integration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
